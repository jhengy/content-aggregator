# LLM Provider Selection (default: openai)
LLM_PROVIDER=openai

# OpenAI-Compatible API Configuration
# Supports: NVIDIA NIM, Ollama, LM Studio, LiteLLM, OpenAI, Azure OpenAI, etc.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_SUMMARIZE_POST=
OPENAI_MODEL_SUMMARIZE_ALL=
OPENAI_MODEL_DATE_EXTRACT=

# Gemini API Configuration (use when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL_SUMMARIZE_POST=gemini-2.0-flash-exp
# GEMINI_MODEL_SUMMARIZE_ALL=gemini-2.0-flash-exp
# GEMINI_MODEL_DATE_EXTRACT=gemini-2.0-flash-exp

# Debug Mode
DEBUG=false

# Article Processing
ARTICLES_LIMIT=100
